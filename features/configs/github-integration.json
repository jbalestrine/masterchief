{
  "name": "github-integration",
  "display_name": "GitHub Integration",
  "description": "Connect to GitHub repositories and manage resources",
  "version": "1.0.0",
  "enabled": true,
  "dependencies": ["PyGitHub", "requests"],
  "routes": [
    {
      "path": "/api/features/github/repos",
      "method": "GET",
      "description": "List repositories"
    },
    {
      "path": "/api/features/github/repos/{owner}/{repo}",
      "method": "GET",
      "description": "Get repo details"
    },
    {
      "path": "/api/features/github/clone",
      "method": "POST",
      "description": "Clone repository"
    },
    {
      "path": "/api/features/github/files/{repo_name}",
      "method": "GET",
      "description": "Get repository files"
    },
    {
      "path": "/api/features/github/file-content/{repo_name}",
      "method": "GET",
      "description": "Get file content"
    },
    {
      "path": "/api/features/github/save-file",
      "method": "POST",
      "description": "Save file to scripts"
    },
    {
      "path": "/api/features/github/create-repo",
      "method": "POST",
      "description": "Create repository"
    }
  ],
  "scripts": [],
  "ui_components": [
    {
      "type": "card",
      "title": "GitHub Repositories",
      "content": "Browse and manage GitHub repositories",
      "actions": [
        {
          "label": "Open GitHub Manager",
          "action": "navigate",
          "url": "/github"
        }
      ]
    }
  ]
}