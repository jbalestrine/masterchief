Configuration EnterpriseWebIIS
{
    Import-DscResource -ModuleName PSDesiredStateConfiguration

    Node localhost
    {
        WindowsFeature IIS
        {
            Name   = "Web-Server"
            Ensure = "Present"
        }

        WindowsFeature IISMgmt
        {
            Name   = "Web-Mgmt-Tools"
            Ensure = "Present"
        }

        WindowsFeature DotNet48
        {
            Name   = "NET-Framework-45-Core"
            Ensure = "Present"
        }

        WindowsFeature PSRemoting
        {
            Name   = "PowerShellRoot"
            Ensure = "Present"
        }

        Registry EnableRDP
        {
            Key       = "HKLM:\System\CurrentControlSet\Control\Terminal Server"
            ValueName = "fDenyTSConnections"
            ValueData = 0
            ValueType = "Dword"
        }
    }
}

EnterpriseWebIIS
Start-DscConfiguration -Path .\EnterpriseWebIIS -Wait -Force -Verbose
