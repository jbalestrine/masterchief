
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enterprise Application Deployment",
  "type": "object",
  "required": ["location", "resourceGroup", "adminUser"],
  "properties": {
    "location": { "type": "string", "default": "eastus" },
    "resourceGroup": { "type": "string" },
    "adminUser": { "type": "string" },
    "enableSOFS": { "type": "boolean", "default": true },
    "enableDocker": { "type": "boolean", "default": false },
    "enableWSL": { "type": "boolean", "default": false }
  }
}
