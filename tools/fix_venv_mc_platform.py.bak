import os
from pathlib import Path
root = Path('venv') / 'Lib' / 'site-packages'
if not root.exists():
    print('venv site-packages not found at', root)
    raise SystemExit(1)
count = 0
for p in root.rglob('*.py'):
    try:
        s = p.read_text(encoding='utf-8')
    except Exception:
        continue
    if 'mc_platform' in s:
        bak = p.with_suffix(p.suffix + '.bak')
        if not bak.exists():
            p.rename(bak)
            s = bak.read_text(encoding='utf-8')
            s2 = s.replace('mc_platform', 'platform')
            p.write_text(s2, encoding='utf-8')
            print('Fixed', p)
            count += 1
        else:
            # already backed up, just replace in place
            s2 = s.replace('mc_platform', 'platform')
            p.write_text(s2, encoding='utf-8')
            print('Fixed (no backup created)', p)
            count += 1
print('Total files fixed:', count)
