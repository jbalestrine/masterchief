#!/usr/bin/env python3
"""Revert accidental import renames from mc_platform -> platform.

Run from repo root:
    .\venv\Scripts\python.exe .\tools\revert_mc_platform.py

This will create backups (.bak) for modified files.
"""
import os
from pathlib import Path
root = Path('.').resolve()
skip_dirs = {'venv', '.git', '__pycache__'}
changed = []
for p in root.rglob('*.py'):
    # skip files in venv or hidden dirs
    try:
        parts = set(p.relative_to(root).parts)
    except Exception:
        continue
    if parts & skip_dirs:
        continue
    try:
        s = p.read_text(encoding='utf-8')
    except Exception:
        continue
    if 'mc_platform' in s:
        bak = p.with_suffix(p.suffix + '.bak')
        if not bak.exists():
            bak.write_text(s, encoding='utf-8')
        s2 = s.replace('mc_platform', 'platform')
        p.write_text(s2, encoding='utf-8')
        changed.append(str(p))
print('Reverted imports in', len(changed), 'files')
for f in changed:
    print(f)
