# ircrc.example — example client config to auto-connect to local IRC server
# Drop this into your IRC client's config or adapt for container startup scripts.

[server]
host=127.0.0.1
port=6667
nick=webbot
username=webbot
realname=IRC Super Control Kernel Bot
ssl=false

# Channels to auto-join (comma-separated)
autojoin=#masterchief

# Optional: identify with NickServ (if enabled on the server)
#nickserv_password=your_password_here

# Post-connect commands (client-specific; example shows generic JOIN)
# You may need to adapt these to your IRC client (irssi/weechat/etc.)
# Example: /join #masterchief
