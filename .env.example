# MasterChief Authentication Configuration
# Copy this file to .env and fill in your credentials

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
SESSION_TIMEOUT=3600

# Azure AD Configuration (for Azure login and Azure SDK)
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# OKTA Configuration (for OKTA SSO)
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
OKTA_ISSUER=https://your-org.okta.com/oauth2/default

# GitHub Configuration (for GitHub OAuth and API)
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# GitHub Personal Access Token (alternative to OAuth for API access)
GITHUB_TOKEN=your-github-personal-access-token

# Admin Configuration
ADMIN_TOKEN=your-admin-token
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-this-password