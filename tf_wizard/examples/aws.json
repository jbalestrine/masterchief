{
  "module_name": "s3_bucket_module",
  "provider": "aws",
  "variables": [
    {"name": "region", "type": "string", "default": "us-east-1", "description": "AWS region"},
    {"name": "bucket_name", "type": "string", "description": "S3 bucket name"}
  ],
  "resources": [
    {"type": "aws_s3_bucket", "name": "bucket", "args": {"bucket": "${var.bucket_name}"}}
  ],
  "outputs": [
    {"name": "bucket_id", "value": "aws_s3_bucket.bucket.id"}
  ]
}
