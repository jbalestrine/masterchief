  description = "ID of the Log Analytics workspace (if created)"
  value       = var.enable_monitoring && var.log_analytics_workspace_id == "" ? azurerm_log_analytics_workspace.aks[0].id : var.log_analytics_workspace_id
}

output "log_analytics_workspace_name" {
  description = "Name of the Log Analytics workspace (if created)"
