# Upload documentation to storage account
resource "azurerm_storage_blob" "architecture_diagram" {
  count = var.generate_diagrams && var.create_docs_storage ? 1 : 0

  name                   = "diagrams/architecture-diagram.md"
  storage_account_name   = azurerm_storage_account.docs[0].name
  storage_container_name = azurerm_storage_container.diagrams[0].name
  type                   = "Block"
  source                 = local_file.architecture_diagram[0].filename
  content_type           = "text/markdown"
}

