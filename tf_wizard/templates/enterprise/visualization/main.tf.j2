# Generate index page for static website
resource "local_file" "index_html" {
  count = var.create_docs_storage ? 1 : 0

  filename = "${path.module}/index.html"
  content  = templatefile("${path.module}/templates/index.html.tmpl", {
    enterprise_name = var.enterprise_name
    generate_diagrams = var.generate_diagrams
    generate_docs     = var.generate_docs
    generate_reports  = var.generate_reports
  })
}

resource "azurerm_storage_blob" "index_html" {
  count = var.create_docs_storage ? 1 : 0

  name                   = "index.html"
  storage_account_name   = azurerm_storage_account.docs[0].name
  storage_container_name = "$web"
  type                   = "Block"
  source                 = local_file.index_html[0].filename
  content_type           = "text/html"
}