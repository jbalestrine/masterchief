# Visualization Module for Enterprise Hub-and-Spoke Architecture
# This module generates documentation, diagrams, and reports

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.0"
    }
  }
}

# Storage account for documentation and diagrams
resource "azurerm_storage_account" "docs" {
  count = var.create_docs_storage ? 1 : 0

  name                     = var.docs_storage_account_name
  resource_group_name      = var.resource_group_name
  location                 = var.location
  account_tier             = "Standard"
  account_replication_type = "LRS"
  account_kind             = "StorageV2"

  static_website {
    index_document = "index.html"
  }

  tags = var.tags
}

resource "azurerm_storage_container" "docs" {
  count = var.create_docs_storage ? 1 : 0

  name                  = "docs"
  storage_account_name  = azurerm_storage_account.docs[0].name
  container_access_type = "blob"
}

resource "azurerm_storage_container" "diagrams" {
  count = var.create_docs_storage ? 1 : 0

  name                  = "diagrams"
  storage_account_name  = azurerm_storage_account.docs[0].name
  container_access_type = "blob"
}

resource "azurerm_storage_container" "reports" {
  count = var.create_docs_storage ? 1 : 0

  name                  = "reports"
  storage_account_name  = azurerm_storage_account.docs[0].name
  container_access_type = "blob"
}

# Generate architecture diagram (Mermaid format)
resource "local_file" "architecture_diagram" {
  count = var.generate_diagrams ? 1 : 0

  filename = "${path.module}/architecture-diagram.md"
  content  = templatefile("${path.module}/templates/architecture-diagram.md.tmpl", {
    enterprise_name     = var.enterprise_name
    hub_location        = var.hub_location
    spoke_locations     = var.spoke_locations
    enable_firewall     = var.enable_firewall
    enable_bastion      = var.enable_bastion
    enable_aks          = var.enable_aks
    enable_app_gateway  = var.enable_app_gateway
    enable_key_vault    = var.enable_key_vault
    enable_acr          = var.enable_acr
    enable_storage      = var.enable_storage
    enable_monitoring   = var.enable_monitoring
  })
}

# Generate network topology diagram
resource "local_file" "network_diagram" {
  count = var.generate_diagrams ? 1 : 0

  filename = "${path.module}/network-diagram.md"
  content  = templatefile("${path.module}/templates/network-diagram.md.tmpl", {
    enterprise_name     = var.enterprise_name
    hub_vnet_address    = var.hub_vnet_address
    hub_subnets         = var.hub_subnets
    spoke_vnets         = var.spoke_vnets
    enable_firewall     = var.enable_firewall
    enable_bastion      = var.enable_bastion
    enable_expressroute = var.enable_expressroute
    enable_vpn          = var.enable_vpn
  })
}

# Generate security overview diagram
resource "local_file" "security_diagram" {
  count = var.generate_diagrams ? 1 : 0

  filename = "${path.module}/security-diagram.md"
  content  = templatefile("${path.module}/templates/security-diagram.md.tmpl", {
    enterprise_name     = var.enterprise_name
    enable_firewall     = var.enable_firewall
    enable_nsg          = var.enable_nsg
    enable_waf          = var.enable_waf
    enable_key_vault    = var.enable_key_vault
    enable_monitoring   = var.enable_monitoring
    security_groups     = var.security_groups
  })
}

