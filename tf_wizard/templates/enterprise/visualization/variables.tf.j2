# Variables for Visualization Module

# Basic Configuration
variable "enterprise_name" {
  description = "Name of the enterprise deployment"
  type        = string
  default     = "enterprise"
}

variable "resource_group_name" {
  description = "Name of the resource group for documentation storage"
  type        = string
  default     = ""
}

variable "location" {
  description = "Azure region for documentation storage"
  type        = string
  default     = "East US"
}

variable "subscription_id" {
  description = "Azure subscription ID"
  type        = string
  default     = ""
}

variable "tenant_id" {
  description = "Azure tenant ID"
  type        = string
  default     = ""
}

variable "tags" {
  description = "Tags to apply to resources"
  type        = map(string)
  default     = {}
}

# Storage Configuration
variable "create_docs_storage" {
  description = "Whether to create storage account for documentation"
  type        = bool
  default     = true
}

variable "docs_storage_account_name" {
  description = "Name of the storage account for documentation"
  type        = string
  default     = ""
}

# Diagram Generation
variable "generate_diagrams" {
  description = "Whether to generate architecture diagrams"
  type        = bool
  default     = true
}

variable "hub_location" {
  description = "Location of the hub"
  type        = string
  default     = "East US"
}

variable "spoke_locations" {
  description = "List of spoke locations"
  type        = list(string)
  default     = []
}

variable "hub_vnet_address" {
  description = "Address space for hub VNET"
  type        = string
  default     = "10.0.0.0/16"
}

variable "hub_subnets" {
  description = "Map of hub subnets"
  type        = map(string)
  default     = {}
}

variable "spoke_vnets" {
  description = "Map of spoke VNETs with their address spaces"
  type        = map(string)
  default     = {}
}

# Feature Flags for Diagrams
variable "enable_firewall" {
  description = "Whether Azure Firewall is enabled"
  type        = bool
  default     = true
}

variable "enable_bastion" {
  description = "Whether Azure Bastion is enabled"
  type        = bool
  default     = true
}

variable "enable_expressroute" {
  description = "Whether ExpressRoute is enabled"
  type        = bool
  default     = false
}

variable "enable_vpn" {
  description = "Whether VPN Gateway is enabled"
  type        = bool
  default     = true
}

variable "enable_aks" {
  description = "Whether AKS is enabled"
  type        = bool
  default     = true
}

variable "enable_app_gateway" {
  description = "Whether Application Gateway is enabled"
  type        = bool
  default     = true
}

variable "enable_key_vault" {
  description = "Whether Key Vault is enabled"
  type        = bool
  default     = true
}

variable "enable_acr" {
  description = "Whether Azure Container Registry is enabled"
  type        = bool
  default     = true
}

variable "enable_storage" {
  description = "Whether Storage Account is enabled"
  type        = bool
  default     = true
}

variable "enable_monitoring" {
  description = "Whether monitoring is enabled"
  type        = bool
  default     = true
}

variable "enable_nsg" {
  description = "Whether Network Security Groups are enabled"
  type        = bool
  default     = true
}

variable "enable_waf" {
  description = "Whether Web Application Firewall is enabled"
  type        = bool
  default     = true
}

# Documentation Generation
variable "generate_docs" {
  description = "Whether to generate documentation"
  type        = bool
  default     = true
}

# Report Generation
variable "generate_reports" {
  description = "Whether to generate reports"
  type        = bool
  default     = true
}

# Security Configuration for Diagrams
variable "security_groups" {
  description = "List of security groups"
  type        = list(string)
  default     = []
}

variable "compliance_requirements" {
  description = "List of compliance requirements"
  type        = list(string)
  default     = ["ISO 27001", "SOC 2", "PCI DSS"]
}

# Cost Estimation Variables
variable "aks_node_count" {
  description = "Number of AKS nodes for cost estimation"
  type        = number
  default     = 3
}

variable "aks_node_size" {
  description = "Size of AKS nodes for cost estimation"
  type        = string
  default     = "Standard_D2_v2"
}

variable "storage_redundancy" {
  description = "Storage redundancy type"
  type        = string
  default     = "LRS"
}

variable "currency" {
  description = "Currency for cost estimation"
  type        = string
  default     = "USD"
}

# Operations Variables
variable "monitoring_workspace" {
  description = "Name of the monitoring workspace"
  type        = string
  default     = ""
}

variable "alert_rules" {
  description = "List of alert rules"
  type        = list(string)
  default     = []
}

variable "backup_policies" {
  description = "List of backup policies"
  type        = list(string)
  default     = []
}

variable "audit_retention" {
  description = "Audit log retention period in days"
  type        = number
  default     = 365
}