# Variables for User Management Module

# Scope and Assignment Configuration
variable "scope" {
  description = "The scope at which the role assignment applies (subscription, resource group, etc.)"
  type        = string
  default     = ""
}

variable "hub_scope" {
  description = "The scope of the hub resource group"
  type        = string
  default     = ""
}

variable "spoke_scope" {
  description = "The scope of the spoke resource group"
  type        = string
  default     = ""
}

variable "assignable_scopes" {
  description = "List of scopes where the custom role can be assigned"
  type        = list(string)
  default     = []
}

variable "management_group_id" {
  description = "ID of the management group (if using management groups)"
  type        = string
  default     = ""
}

# Platform Admin Group Configuration
variable "create_platform_admin_group" {
  description = "Whether to create the platform admin group"
  type        = bool
  default     = true
}

variable "platform_admin_group_name" {
  description = "Name of the platform admin group"
  type        = string
  default     = "Platform-Administrators"
}

variable "platform_admin_owners" {
  description = "List of object IDs for platform admin group owners"
  type        = list(string)
  default     = []
}

variable "platform_admin_members" {
  description = "List of object IDs for platform admin group members"
  type        = list(string)
  default     = []
}

variable "assign_platform_admin_role" {
  description = "Whether to assign platform admin role to the group"
  type        = bool
  default     = true
}

